# === Jonis Catering – Schutz des Web-Roots ===
# Das Git-Deployment legt das komplette Repository ins Web-Root.
# Diese Regeln verhindern, dass Entwickler-/Repo-Dateien öffentlich
# abrufbar sind (z. B. .git, package.json, CLAUDE.md, scripts/).

# Keine Verzeichnis-Auflistung
Options -Indexes
DirectoryIndex index.html

RewriteEngine On

# www-Variante dauerhaft auf die Hauptdomain weiterleiten
RewriteCond %{HTTP_HOST} ^www\.jonis-catering\.de$ [NC]
RewriteRule ^ https://jonis-catering.de%{REQUEST_URI} [R=301,L]

# Zugriff auf versteckte Dateien/Ordner verbieten (z. B. .git), außer .well-known
RewriteRule (^|/)\.(?!well-known/)([^/]+) - [F,L]

# Entwickler- und Repo-Dateien nicht ausliefern
<FilesMatch "\.(md|json|lock|sh|mjs|yml|yaml)$">
    Require all denied
</FilesMatch>

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpeg "access plus 6 months"
    ExpiresByType image/svg+xml "access plus 6 months"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css application/javascript application/json application/xml image/svg+xml
</IfModule>
